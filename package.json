{
  "name": "distill",
  "version": "0.2.0-beta.2",
  "description": "Local-first conversation collector for Codex CLI, Claude Code, and OpenCode",
  "private": true,
  "workspaces": [
    "apps/distill-desktop"
  ],
  "scripts": {
    "check:docs": "node scripts/check-docs.mjs",
    "release:check": "node scripts/check-release.mjs",
    "release:package:windows": "npm run --workspace @distill/desktop package:windows:beta",
    "desktop:dev": "npm run --workspace @distill/desktop tauri -- dev",
    "desktop:build": "npm run --workspace @distill/desktop tauri -- build --no-bundle",
    "desktop:package:macos": "npm run --workspace @distill/desktop package:macos",
    "desktop:smoke:macos": "npm run --workspace @distill/desktop smoke:macos",
    "desktop:package:linux": "npm run --workspace @distill/desktop package:linux",
    "desktop:smoke:linux": "npm run --workspace @distill/desktop smoke:linux",
    "desktop:test": "npm run --workspace @distill/desktop test",
    "desktop:typecheck": "npm run --workspace @distill/desktop typecheck",
    "desktop:lint": "npm run --workspace @distill/desktop lint",
    "desktop:format": "npm run --workspace @distill/desktop format:check",
    "desktop:frontend:build": "npm run --workspace @distill/desktop build",
    "rebuild:fmt": "cargo fmt --all -- --check",
    "rebuild:clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "rebuild:test": "cargo test --workspace",
    "rebuild:build": "cargo build --workspace"
  }
}
