{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Distill",
  "version": "0.1.0",
  "identifier": "dev.distill.desktop",
  "build": {
    "beforeDevCommand": "npm run --workspace @distill/desktop dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run --workspace @distill/desktop build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Distill",
        "width": 880,
        "height": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"]
  }
}
