{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Distill",
  "version": "0.1.0",
  "identifier": "dev.distill.desktop",
  "build": {
    "beforeDevCommand": "npm run --workspace @distill/desktop dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "npm run --workspace @distill/desktop build",
      "cwd": ".."
    },
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Distill",
        "width": 880,
        "height": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
