import { HorizontalBox, ListView } from "std-widgets.slint";
import {
    ArtifactCardData,
    BadgeChip,
    Button,
    DetailContextRowData,
    LaneChip,
    SessionBadgeData,
    SessionLaneData,
    SessionListRowData,
    SessionRow,
    SourceRowCard,
    TranscriptMessageData
} from "components.slint";
import { ShellStore } from "shell_store.slint";
import { Theme } from "theme.slint";

export global SessionsStore {
    in property <[SessionLaneData]> session_lanes;
    in property <[SessionListRowData]> session_rows;
    in property <[SessionBadgeData]> session_secondary_badges;
    in property <[string]> session_labels;
    in property <[string]> session_tags;
    in property <[DetailContextRowData]> session_context_rows;
    in property <[TranscriptMessageData]> transcript_rows;
    in property <[ArtifactCardData]> artifact_rows;
    in property <string> sessions_empty_title;
    in property <string> sessions_empty_message;
    in property <string> session_detail_title;
    in property <string> session_detail_summary;
    in property <string> session_provenance_json;
    in property <string> session_detail_empty_title;
    in property <string> session_detail_empty_message;
    in property <bool> export_enabled;
    in property <bool> curation_enabled;

    callback session_lane_selected(int);
    callback session_selected(int);
    callback adjust_sessions_width(int);
}

export component SessionsPane inherits Rectangle {
    in property <length> list_width: 340px;

    background: transparent;

    Rectangle {
        width: root.list_width;
        height: parent.height;
        background: #1a1a1e;

        Rectangle {
            x: parent.width - 1px;
            y: 0;
            width: 1px;
            height: parent.height;
            background: Theme.line;
        }

        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: 48px;
            background: Theme.bg_top;

            Text {
                x: 16px;
                y: 16px;
                text: ShellStore.sidebar_count_label;
                color: Theme.muted;
                font-size: 12px;
                font-family: "Menlo";
                font-weight: 600;
            }

            Text {
                x: parent.width - 130px;
                y: 16px;
                width: 114px;
                horizontal-alignment: right;
                text: ShellStore.scanned_label;
                color: Theme.dim;
                font-size: 11px;
                font-family: "Menlo";
                overflow: elide;
            }

            Rectangle {
                x: 0;
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: Theme.line;
            }
        }

        HorizontalBox {
            x: 14px;
            y: 60px;
            width: parent.width - 28px;
            height: 30px;
            spacing: 8px;

            for lane[index] in SessionsStore.session_lanes : Rectangle {
                width: 96px;
                LaneChip {
                    width: parent.width;
                    label: lane.label;
                    selected: lane.selected;
                    clicked => { SessionsStore.session_lane_selected(index); }
                }
            }
        }

        ListView {
            x: 0;
            y: 102px;
            width: parent.width;
            height: ShellStore.sources_open ? parent.height - 284px : parent.height - 164px;

            for row in SessionsStore.session_rows : SessionRow {
                width: parent.width;
                item: row;
                clicked(id) => { SessionsStore.session_selected(id); }
            }
        }

        if SessionsStore.session_rows.length == 0 : Rectangle {
            x: 16px;
            y: 112px;
            width: parent.width - 32px;
            height: 90px;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.line;
            background: Theme.panel;

            Text {
                x: 14px;
                y: 14px;
                width: parent.width - 28px;
                text: SessionsStore.sessions_empty_title;
                color: Theme.ink;
                font-size: 14px;
                font-weight: 700;
            }

            Text {
                x: 14px;
                y: 38px;
                width: parent.width - 28px;
                text: SessionsStore.sessions_empty_message;
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
            }
        }

        Rectangle {
            x: 0;
            y: parent.height - (ShellStore.sources_open ? 182px : 62px);
            width: parent.width;
            height: 36px;
            background: Theme.bg_top;

            TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { ShellStore.toggle_sources_requested(); }
            }

            Text {
                x: 16px;
                y: 10px;
                text: (ShellStore.sources_open ? "▾ " : "▸ ") + "Sources";
                color: Theme.muted;
                font-size: 12px;
                font-family: "Menlo";
                font-weight: 600;
            }

            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: 1px;
                background: Theme.line;
            }
        }

        if ShellStore.sources_open : Rectangle {
            x: 0;
            y: parent.height - 146px;
            width: parent.width;
            height: 146px;
            background: Theme.panel;

            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: 1px;
                background: Theme.line;
            }

            ListView {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;

                for row in ShellStore.source_rows : SourceRowCard {
                    width: parent.width;
                    item: row;
                }
            }
        }
    }

    Rectangle {
        x: root.list_width;
        y: 0;
        width: parent.width - root.list_width;
        height: parent.height;
        background: transparent;

        toolbar := Rectangle {
            x: 24px;
            y: 20px;
            width: parent.width - 48px;
            height: 132px;
            background: transparent;

            Text {
                x: 0;
                y: 4px;
                width: parent.width - 220px;
                text: SessionsStore.session_detail_title == "" ? "Select a session" : SessionsStore.session_detail_title;
                color: Theme.ink;
                font-size: 24px;
                font-weight: 700;
                wrap: word-wrap;
            }

            Text {
                x: 0;
                y: 40px;
                width: parent.width - 220px;
                text: SessionsStore.session_detail_summary;
                color: Theme.muted;
                font-size: 14px;
                wrap: word-wrap;
            }

            Rectangle {
                x: parent.width - 204px;
                y: 4px;
                width: 204px;
                height: 92px;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.line;
                background: Theme.panel;

                Button {
                    x: 12px;
                    y: 12px;
                    width: 80px;
                    text: "⤓ Export";
                    ghost: true;
                    enabled: false;
                }

                Button {
                    x: 12px;
                    y: 50px;
                    width: 88px;
                    text: "train";
                    ghost: true;
                    enabled: false;
                }

                Button {
                    x: 108px;
                    y: 50px;
                    width: 84px;
                    text: "holdout";
                    ghost: true;
                    enabled: false;
                }
            }

            for badge[index] in SessionsStore.session_secondary_badges : BadgeChip {
                x: index < 5 ? 0px + index * 126px : 0px + (index - 5) * 126px;
                y: index < 5 ? 94px : 122px;
                text: badge.text;
                tone: badge.tone;
            }
        }

        curation_bar := Rectangle {
            x: 24px;
            y: 160px;
            width: parent.width - 48px;
            height: 82px;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.line;
            background: Theme.panel;

            Text {
                x: 16px;
                y: 12px;
                text: "Labels";
                color: Theme.ink;
                font-size: 12px;
                font-family: "Menlo";
                font-weight: 700;
            }

            for label[index] in SessionsStore.session_labels : BadgeChip {
                x: index < 5 ? 16px + index * 104px : 16px + (index - 5) * 104px;
                y: index < 5 ? 34px : 60px;
                text: label;
                tone: "muted";
                disabled: true;
            }

            Text {
                x: 16px;
                y: 58px;
                text: "Tags";
                color: Theme.ink;
                font-size: 12px;
                font-family: "Menlo";
                font-weight: 700;
            }

            for tag[index] in SessionsStore.session_tags : BadgeChip {
                x: index < 5 ? 64px + index * 104px : 64px + (index - 5) * 104px;
                y: index < 5 ? 52px : 78px;
                text: "#" + tag;
                tone: "muted";
                disabled: true;
            }
        }

        context_panel := Rectangle {
            x: 24px;
            y: 254px;
            width: parent.width - 48px;
            height: 128px;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.line;
            background: Theme.panel;

            Text {
                x: 16px;
                y: 12px;
                text: "Projection Metadata";
                color: Theme.ink;
                font-size: 14px;
                font-weight: 700;
            }

            for row[index] in SessionsStore.session_context_rows : Text {
                x: 16px;
                y: 38px + index * 16px;
                width: parent.width - 32px;
                text: row.label + ": " + row.value;
                color: Theme.muted;
                font-size: 11px;
                font-family: row.presentation == "copy" ? "Menlo" : "Inter";
                overflow: elide;
            }
        }

        provenance_panel := Rectangle {
            x: 24px;
            y: 394px;
            width: parent.width - 48px;
            height: 96px;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.line;
            background: Theme.panel;

            Text {
                x: 16px;
                y: 12px;
                text: "Provenance";
                color: Theme.ink;
                font-size: 14px;
                font-weight: 700;
            }

            Text {
                x: 16px;
                y: 36px;
                width: parent.width - 32px;
                height: 48px;
                text: SessionsStore.session_provenance_json == "" ? "No provenance JSON on the current projection." : SessionsStore.session_provenance_json;
                color: Theme.muted;
                font-size: 11px;
                font-family: "Menlo";
                wrap: word-wrap;
                overflow: elide;
            }
        }

        artifacts_panel := Rectangle {
            x: 24px;
            y: 502px;
            width: parent.width * 0.34;
            height: parent.height - 526px;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.line;
            background: Theme.panel;

            Text {
                x: 16px;
                y: 12px;
                text: "Artifacts";
                color: Theme.ink;
                font-size: 14px;
                font-weight: 700;
            }

            ListView {
                x: 0;
                y: 40px;
                width: parent.width;
                height: parent.height - 40px;

                for row in SessionsStore.artifact_rows : Rectangle {
                    height: 94px;
                    width: parent.width;
                    background: transparent;

                    Text { x: 14px; y: 10px; width: parent.width - 28px; text: row.title; color: Theme.ink; font-size: 12px; font-weight: 700; overflow: elide; }
                    Text { x: 14px; y: 30px; width: parent.width - 28px; text: row.meta; color: Theme.dim; font-size: 10px; font-family: "Menlo"; overflow: elide; }
                    Text { x: 14px; y: 46px; width: parent.width - 28px; text: row.preview; color: Theme.muted; font-size: 11px; wrap: word-wrap; overflow: elide; }

                    Rectangle {
                        x: 0;
                        y: parent.height - 1px;
                        width: parent.width;
                        height: 1px;
                        background: Theme.line;
                    }
                }
            }
        }

        transcript_panel := Rectangle {
            x: 24px + parent.width * 0.34 + 16px;
            y: 502px;
            width: parent.width - (40px + parent.width * 0.34 + 16px);
            height: parent.height - 526px;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.line;
            background: Theme.panel;

            Text {
                x: 16px;
                y: 12px;
                text: "Transcript";
                color: Theme.ink;
                font-size: 14px;
                font-weight: 700;
            }

            ListView {
                x: 0;
                y: 40px;
                width: parent.width;
                height: parent.height - 40px;

                for row in SessionsStore.transcript_rows : Rectangle {
                    height: 96px;
                    width: parent.width;
                    background: transparent;

                    Text {
                        x: 14px;
                        y: 10px;
                        width: parent.width - 28px;
                        text: row.role + " · " + row.message_kind + " · " + row.ordinal_text + " · " + row.timestamp_text;
                        color: Theme.muted;
                        font-size: 11px;
                        font-family: "Menlo";
                        overflow: elide;
                    }

                    Text {
                        x: 14px;
                        y: 30px;
                        width: parent.width - 28px;
                        text: row.body;
                        color: Theme.ink;
                        font-size: 13px;
                        wrap: word-wrap;
                        overflow: elide;
                    }

                    Rectangle {
                        x: 0;
                        y: parent.height - 1px;
                        width: parent.width;
                        height: 1px;
                        background: Theme.line;
                    }
                }
            }
        }

        if SessionsStore.transcript_rows.length == 0 && SessionsStore.artifact_rows.length == 0 && SessionsStore.session_detail_empty_title != "" : Rectangle {
            x: 24px;
            y: 160px;
            width: parent.width - 48px;
            height: parent.height - 184px;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.line;
            background: Theme.panel;

            Text {
                x: 24px;
                y: 24px;
                text: SessionsStore.session_detail_empty_title;
                color: Theme.ink;
                font-size: 18px;
                font-weight: 700;
            }

            Text {
                x: 24px;
                y: 56px;
                width: parent.width - 48px;
                text: SessionsStore.session_detail_empty_message;
                color: Theme.muted;
                font-size: 13px;
                wrap: word-wrap;
            }
        }
    }
}
