#!/bin/sh
# distill-backup-rclone: a DISTILL backup adapter (docs/backup-adapters.md) that hands objects to
# rclone, so any of its backends works: an S3-compatible store (AWS, Backblaze B2, MinIO and
# other self-hosted ones), WebDAV, and the rest. For a machine reached over SSH, use
# distill-backup-ssh: rclone's SFTP backend can't make the other machine write its disk out.
#
#   [[backup]]
#   name = "offsite"
#   kind = "rclone"
#   remote = "b2:my-bucket/distill"   # an rclone path; objects go in <remote>/objects/
#
# The remote and its credentials are set up with `rclone config`, outside DISTILL. A put checks
# whether the object is there and then uploads it with --immutable. Two puts of one name can both
# upload on a store with no conditional write, and the later one wins.
set -u

remote=""

# One reply line: a tool's message of several lines is joined into one.
reply() { printf '%s\n' "$(printf '%s' "$*" | tr '\n' ' ')"; }

setting() {
    printf '%s' "$2" | sed -n "s/.*\"$1\":\"\\([^\"\\\\]*\\)\".*/\\1/p"
}

valid() { printf '%s' "$1" | grep -Eq '^[0-9a-fA-F]{64}$'; }

# The path `$1` inside the remote. `nas:` is the remote's own starting folder and `nas:/` its root,
# so a remote ending in `/`, or a bare `name:`, takes no `/` before it.
at() {
    case $remote in
    */) printf '%s%s' "$remote" "$1" ;;
    */*) printf '%s/%s' "$remote" "$1" ;;
    *:) printf '%s%s' "$remote" "$1" ;;
    *) printf '%s/%s' "$remote" "$1" ;;
    esac
}

# Whether the remote holds the object `$1`: 0 yes, 1 no, 2 it couldn't tell. rclone exits 3 or 4
# for a folder or file that isn't there and otherwise for an error; an object store answers a
# name it doesn't hold as a folder, so only a file counts.
holds() {
    stat=$(rclone lsjson --stat "$(at "objects/$1")" 2>/dev/null </dev/null)
    case $? in
    0) printf '%s' "$stat" | grep -Eq '"IsDir": *false' ;;
    3 | 4) return 1 ;;
    *) return 2 ;;
    esac
}

ready=""
while IFS= read -r line; do
    cmd=${line%% *}
    rest=${line#"$cmd"}
    rest=${rest# }
    if [ "$cmd" != hello ] && [ -z "$ready" ]; then
        reply "error no target yet: hello first"
        continue
    fi
    case "$cmd" in
    hello)
        version=${rest%% *}
        rest=${rest#"$version" }
        open=${rest%% *}
        json=${rest#"$open" }
        [ "$version" = 1 ] || { reply "error unsupported protocol version $version"; continue; }
        remote=$(setting remote "$json")
        if [ -z "$remote" ]; then
            reply "error the target needs a remote"
            continue
        fi
        command -v rclone >/dev/null || { reply "error no rclone on PATH"; continue; }
        case "$open" in
        probe)
            # The remote must be there already: writing to one that isn't could make it.
            probe=$(at ".distill-probe-$$")
            if ! out=$(rclone lsf --max-depth 1 "$remote" </dev/null 2>&1); then
                reply "error $remote is not there ($out)"
            elif out=$(printf 'distill' | rclone rcat "$probe" 2>&1) && rclone deletefile "$probe" </dev/null 2>/dev/null; then
                reply ok
            else
                reply "error $remote can't be written to${out:+ ($out)}"
            fi
            ;;
        first)
            if out=$(rclone mkdir "$(at objects)" </dev/null 2>&1); then
                ready=1
                reply ok
            else
                reply "error can't set up $remote ($out)"
            fi
            ;;
        *)
            # An object store lists a prefix that isn't there as empty, so a target used before
            # must hold an object, or it isn't the place it was.
            if out=$(rclone lsf --files-only --max-depth 1 "$(at objects)" </dev/null 2>&1) && [ -n "$out" ]; then
                ready=1
                reply ok
            else
                reply "error $remote/objects holds nothing, though this target was used before (is the remote right?)${out:+ ($out)}"
            fi
            ;;
        esac
        ;;
    list)
        if names=$(rclone lsf --files-only --max-depth 1 "$(at objects)" </dev/null); then
            names=$(printf '%s\n' "$names" | grep -E '^[0-9a-fA-F]{64}$')
            n=$(printf '%s' "$names" | grep -c .)
            reply "ok $n"
            [ "$n" -gt 0 ] && printf '%s\n' "$names"
        else
            reply "error can't list $remote/objects"
        fi
        ;;
    put)
        name=${rest%% *}
        file=${rest#"$name" }
        valid "$name" || { reply "error not an object name"; continue; }
        holds "$name"
        there=$?
        if [ "$there" = 0 ]; then
            reply "ok present"
        elif [ "$there" = 2 ]; then
            reply "error can't tell whether $remote holds $name"
        elif rclone copyto --immutable "$file" "$(at "objects/$name")" </dev/null; then
            reply "ok stored"
        else
            reply "error can't store $name at $remote"
        fi
        ;;
    get)
        name=${rest%% *}
        file=${rest#"$name" }
        valid "$name" || { reply "error not an object name"; continue; }
        # A name the remote doesn't hold copies nothing, and rclone says nothing of it.
        if holds "$name" && rclone copyto "$(at "objects/$name")" "$file" </dev/null && [ -f "$file" ]; then reply ok; else reply "error can't read $name at $remote"; fi
        ;;
    has)
        valid "$rest" || { reply "error not an object name"; continue; }
        holds "$rest"
        case $? in
        0) reply "ok yes" ;;
        1) reply "ok no" ;;
        *) reply "error can't tell whether $remote holds $rest" ;;
        esac
        ;;
    delete)
        valid "$rest" || { reply "error not an object name"; continue; }
        holds "$rest"
        there=$?
        if [ "$there" = 1 ] || { [ "$there" = 0 ] && rclone deletefile "$(at "objects/$rest")" </dev/null; }; then
            reply ok
        else
            reply "error can't delete $rest at $remote"
        fi
        ;;
    sync)
        # An upload to a store is kept when rclone returns; one to a disk (rclone's local backend)
        # is only once the system has written it out.
        if sync; then reply ok; else reply "error can't sync"; fi
        ;;
    *)
        reply "error unknown command $cmd"
        ;;
    esac
done
